<Window x:Class="MeetcoApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meetco Settings"
        Width="620" Height="640" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B6B73" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <TabControl Margin="10">
        <!-- OpenAI -->
        <TabItem Header="OpenAI">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,6,14,14">
                    <TextBlock Text="OpenAI API key" Style="{StaticResource Label}" />
                    <PasswordBox x:Name="KeyBox" Padding="4" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save API Key" Click="OnSaveKey" />
                        <Button Content="Test Connection" Click="OnTestConnection" IsEnabled="{Binding IsTesting, Converter={StaticResource InvertBool}}" />
                        <Button Content="Delete Key" Click="OnDeleteKey" />
                    </StackPanel>
                    <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Hint}" />
                    <TextBlock Text="{Binding TestResult}" Style="{StaticResource Hint}" Foreground="#FF0A64C8" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Your key is stored only in Windows Credential Manager. Meetco has no account or server; every request goes from this PC straight to OpenAI with your key. Create a key at platform.openai.com/api-keys (API billing must be enabled)." />

                    <TextBlock Text="Answer model" Style="{StaticResource Label}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding AssistantModels}"
                              Text="{Binding Settings.ChatModel, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{Binding AssistantModelNotes}" Style="{StaticResource Hint}" />

                    <TextBlock Text="Transcription model" Style="{StaticResource Label}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding TranscriptionModels}"
                              Text="{Binding Settings.TranscriptionModel, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{Binding TranscriptionModelNotes}" Style="{StaticResource Hint}" />

                    <TextBlock Text="About you" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Settings.UserContext, UpdateSourceTrigger=PropertyChanged, Delay=500}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto" Padding="4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Your role, company, product facts and experience. Meetco speaks from these as if they were your own memories, and never invents personal facts." />

                    <TextBlock Text="Answer language" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding ResponseLanguages}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.ResponseLanguage}" />

                    <TextBlock Text="Translation under the answer" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding ExplanationLanguages}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.ExplanationLanguage}" />

                    <TextBlock Text="Answer style" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding ResponseStyles}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.ResponseStyle}" />

                    <CheckBox Content="Answer questions automatically" IsChecked="{Binding Settings.AutoSuggest}" />

                    <TextBlock Text="API base URL" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Settings.ApiBaseUrl, UpdateSourceTrigger=LostFocus}" Padding="4" />
                    <TextBlock Style="{StaticResource Hint}" Text="Leave as https://api.openai.com/v1 unless you use a compatible proxy." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Audio -->
        <TabItem Header="Audio">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,6,14,14">
                    <TextBlock Text="Listen to" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding CaptureModes}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.CaptureMode}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="System audio is what your PC plays (the other participants). It is captured from the default output device, so the meeting app should play through it." />

                    <TextBlock Text="Microphone" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefreshMicrophones" Margin="8,0,0,0" />
                        <ComboBox ItemsSource="{Binding Microphones}" DisplayMemberPath="Title" SelectedValuePath="Value"
                                  SelectedValue="{Binding MicrophoneChoice}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="If your voice never shows up: Windows Settings → Privacy &amp; security → Microphone → turn on &quot;Let desktop apps access your microphone&quot;." />

                    <TextBlock Text="Response speed" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding LatencyProfiles}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.LatencyProfile}" />

                    <TextBlock Text="Transcription language" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding TranscriptionLanguages}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.TranscriptionLanguage}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Changes apply the next time you start listening." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- General -->
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,6,14,14">
                    <CheckBox Content="Keep Meetco above other windows" IsChecked="{Binding Settings.AlwaysOnTop}" />
                    <CheckBox Content="Hide Meetco from screen sharing and screenshots" IsChecked="{Binding Settings.HideFromScreenSharing}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Best effort: works with Teams, Zoom, Meet in Chrome/Edge and most recorders on Windows 10 2004 or later. Check with a test share before you rely on it." />
                    <CheckBox Content="Global keyboard shortcuts" IsChecked="{Binding Settings.GlobalShortcutsEnabled}" />
                    <CheckBox Content="Scroll the transcript automatically" IsChecked="{Binding Settings.AutoScrollTranscript}" />
                    <CheckBox Content="Clear the transcript when a new session starts" IsChecked="{Binding Settings.ClearTranscriptOnNewSession}" />

                    <TextBlock Text="Panel size at launch" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding PanelSizes}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.DefaultPanelSize}" />

                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding ShortcutList}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Text="Troubleshooting" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open log folder" Click="OnOpenLogs" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Privacy -->
        <TabItem Header="Privacy">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,6,14,14">
                    <CheckBox Content="Save transcripts on this PC" IsChecked="{Binding Settings.SaveTranscriptsLocally}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Off by default. When on, each session's transcript and answers are saved as JSON in your AppData folder. Audio is never saved." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0">
                        <Run Text="Saved sessions: " />
                        <Run Text="{Binding SessionCount, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Open folder" Click="OnOpenHistory" />
                        <Button Content="Delete history" Click="OnDeleteHistory" />
                    </StackPanel>

                    <TextBlock Text="What leaves your PC" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Speech (never silence) is sent to OpenAI for transcription, and the recent transcript plus your About you notes are sent to generate answers. Screenshots are sent only when you attach one. Nothing goes to any Meetco server; there is none." />

                    <TextBlock Text="Responsible use" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Use Meetco openly, with the knowledge of the people you meet, and follow the recording and consent rules that apply to you and your organization." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
