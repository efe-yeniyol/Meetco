<Window x:Class="MeetcoApp.Views.MainPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meetco"
        Width="600" Height="400" MinWidth="340" MinHeight="170"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding Settings.AlwaysOnTop}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <Border Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid Margin="10,8,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: tabs and tools. Dragging the empty area moves the window. -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Answers" Command="{Binding ShowAnswersCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Setter Property="Padding" Value="10,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnswersTab}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Transcript" Command="{Binding ShowTranscriptCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Setter Property="Padding" Value="10,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTranscriptTab}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="Transcribing…" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding Transcription.IsTranscribing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource QuietButton}" Content="Questions to ask" Command="{Binding QuestionsToAskCommand}"
                            ToolTip="Suggest questions you could ask next" />
                    <Button Command="{Binding CaptureScreenCommand}"
                            ToolTip="Attach a screenshot as context for the next answer (click again to remove it)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Setter Property="Content" Value="Screenshot" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Suggestions.HasPendingScreenContext}" Value="True">
                                        <Setter Property="Content" Value="Screenshot attached ✓" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Suggestions.IsCapturingScreen}" Value="True">
                                        <Setter Property="Content" Value="Capturing…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleCompactCommand}" ToolTip="Compact mode (Ctrl+Alt+C)">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Compact" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                            <Setter Property="Text" Value="Expand" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Content="—" Command="{Binding HidePanelCommand}" ToolTip="Hide the panel (Ctrl+Alt+M)" />
                </StackPanel>
            </Grid>

            <!-- Banners -->
            <StackPanel Grid.Row="1">
                <Border Background="{StaticResource ErrorBannerBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,0,6"
                        Visibility="{Binding Session.ErrorMessage, Converter={StaticResource HasContentToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="✕" Command="{Binding DismissSessionMessagesCommand}" />
                        <TextBlock Text="{Binding Session.ErrorMessage}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource WarningBannerBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,0,6"
                        Visibility="{Binding Session.WarningMessage, Converter={StaticResource HasContentToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="✕" Command="{Binding DismissSessionMessagesCommand}" />
                        <TextBlock Text="{Binding Session.WarningMessage}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource ErrorBannerBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,0,6"
                        Visibility="{Binding Suggestions.LastError, Converter={StaticResource HasContentToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="✕" Command="{Binding DismissSuggestionErrorCommand}" />
                        <TextBlock Text="{Binding Suggestions.LastError}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource WarningBannerBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,0,6"
                        Visibility="{Binding Transcription.LastError, Converter={StaticResource HasContentToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="✕" Command="{Binding DismissTranscriptionErrorCommand}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center">
                            <Run Text="Transcription: " FontWeight="SemiBold" />
                            <Run Text="{Binding Transcription.LastError, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Answers tab -->
            <Grid Grid.Row="2" Visibility="{Binding IsAnswersTab, Converter={StaticResource BoolToVisibility}}">

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding Suggestions.CurrentSuggestion, Converter={StaticResource HasContentToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="Answers appear here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                               Text="Click Listen, then join your call. When someone asks you a question, Meetco writes the answer in your words. You can also use What should I say? or Recap at any time." />
                </StackPanel>

                <Grid Visibility="{Binding Suggestions.CurrentSuggestion, Converter={StaticResource HasContentToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card header: kind, streaming state, history -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource QuietButton}" Content="‹" FontSize="14" Command="{Binding ShowOlderCommand}"
                                    IsEnabled="{Binding Suggestions.CanShowOlder}" ToolTip="Older answer" />
                            <TextBlock Text="{Binding Suggestions.HistoryLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource QuietButton}" Content="›" FontSize="14" Command="{Binding ShowNewerCommand}"
                                    IsEnabled="{Binding Suggestions.CanShowNewer}" ToolTip="Newer answer" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Suggestions.CurrentSuggestion.Title}" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="  •  writing…" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                       Visibility="{Binding Suggestions.IsStreamingCurrent, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource GlassScrollViewer}">
                        <StackPanel DataContext="{Binding Suggestions.CurrentSuggestion}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Question}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,6"
                                       Visibility="{Binding Question, Converter={StaticResource HasContentToVisibility}}" />

                            <TextBox Style="{StaticResource SelectableText}" FontSize="17"
                                     Text="{Binding Text, Mode=OneWay}"
                                     Visibility="{Binding Text, Converter={StaticResource HasContentToVisibility}}" />

                            <!-- Explanation / translation -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8,6" Margin="0,10,0,0"
                                    Visibility="{Binding Explanation, Converter={StaticResource HasContentToVisibility}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Background="{StaticResource SurfaceStrongBrush}" CornerRadius="4" Padding="4,1"
                                            Margin="0,1,8,0" VerticalAlignment="Top"
                                            Visibility="{Binding DataContext.ExplanationBadge, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HasContentToVisibility}}">
                                        <TextBlock Text="{Binding DataContext.ExplanationBadge, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                    <TextBox Style="{StaticResource SelectableText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                             Text="{Binding Explanation, Mode=OneWay}" />
                                </DockPanel>
                            </Border>

                            <!-- Key points / suggested questions -->
                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0"
                                          Visibility="{Binding Items, Converter={StaticResource HasContentToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock TextWrapping="Wrap" FontSize="14">
                                                <Run Text="•  " Foreground="{StaticResource AccentBrush}" />
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="14,2,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource HasContentToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding ActionItems, Converter={StaticResource HasContentToVisibility}}">
                                <TextBlock Text="ACTION ITEMS" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding ActionItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='•  {0}'}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding OpenQuestions, Converter={StaticResource HasContentToVisibility}}">
                                <TextBlock Text="OPEN QUESTIONS" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding OpenQuestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='•  {0}'}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Card actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource GlassButton}" Content="Copy" Command="{Binding CopyCommand}"
                                CommandParameter="{Binding Suggestions.CurrentSuggestion}" Margin="0,0,3,0" />
                        <Button Style="{StaticResource GlassButton}" Content="Regenerate" Command="{Binding RegenerateCommand}"
                                CommandParameter="{Binding Suggestions.CurrentSuggestion}" />
                        <Button Style="{StaticResource QuietButton}" Content="Dismiss" Command="{Binding DismissCommand}"
                                CommandParameter="{Binding Suggestions.CurrentSuggestion}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Transcript tab -->
            <Grid Grid.Row="2" Visibility="{Binding IsTranscriptTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="The live transcript appears here while Meetco is listening."
                           Visibility="{Binding Transcript.Segments.Count, Converter={StaticResource HasContentToVisibility}, ConverterParameter=invert}" />

                <ScrollViewer x:Name="TranscriptScroll" Style="{StaticResource GlassScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Transcript.Segments}" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="7" Padding="7,5" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource QuestionHighlightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="Answer" VerticalAlignment="Top"
                                                Command="{Binding DataContext.AnswerSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsQuestion, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding SpeakerLabel}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SystemLevelBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFromUser}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MicLevelBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StartedAt, Converter={StaticResource Time}}" FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                                <Border Background="{StaticResource SurfaceStrongBrush}" CornerRadius="3" Padding="3,0" Margin="6,0,0,0"
                                                        Visibility="{Binding LanguageCode, Converter={StaticResource HasContentToVisibility}}">
                                                    <TextBlock Text="{Binding LanguageCode, Converter={StaticResource UpperCase}}" FontSize="9"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" FontSize="13" Text="{Binding Text, Mode=OneWay}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource GlassButton}" Content="Copy transcript" Command="{Binding CopyTranscriptCommand}" Margin="0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
