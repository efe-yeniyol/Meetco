<Project Sdk="Microsoft.NET.Sdk">

  <!-- Meetco for Windows: WPF floating panels, WASAPI audio capture, Windows Credential Manager. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Meetco</AssemblyName>
    <RootNamespace>MeetcoApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Meetco: your AI companion for every conversation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meetco.Core\Meetco.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!--
    Whisper.net ships native libraries for every platform under runtimes/<rid>/ and loads them from
    there next to the app. Publish only the target platform's, and keep them out of the single-file
    bundle so they stay on disk where Whisper.net looks for them.
  -->
  <Target Name="ShipOnlyTargetWhisperRuntime" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/$(RuntimeIdentifier)/'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'ggml-metal.metal'" />
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/$(RuntimeIdentifier)/'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
